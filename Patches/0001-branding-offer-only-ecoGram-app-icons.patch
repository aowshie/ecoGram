Subject: [PATCH] branding: offer only ecoGram app icons


diff --git a/submodules/SettingsUI/Sources/Themes/ThemeSettingsAppIconItem.swift b/submodules/SettingsUI/Sources/Themes/ThemeSettingsAppIconItem.swift
index 4c6700e21297886aec1d0ad4b7e0e14888f29ab9..a7825e7b400c40c74aac33121383beceaa6b97ed 100644
--- a/submodules/SettingsUI/Sources/Themes/ThemeSettingsAppIconItem.swift
+++ b/submodules/SettingsUI/Sources/Themes/ThemeSettingsAppIconItem.swift
@@ -387,6 +387,11 @@ class ThemeSettingsAppIconItemNode: ListViewItemNode, ItemListItemNode {
                             var name = "Icon"
                             var bordered = true
                             switch icon.name {
+                                case "EcoDark":
+                                    name = item.strings.Appearance_ThemeCarouselNewNight
+                                    bordered = false
+                                case "EcoLight":
+                                    name = item.strings.Appearance_ThemeCarouselDay
                                 case "SGDefault":
                                     name = item.strings.Appearance_AppIconDefault
                                     bordered = false
