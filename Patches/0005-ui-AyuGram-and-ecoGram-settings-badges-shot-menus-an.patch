+    let rawMessage = message._asMessage()
+    let ecoStrings = EcoStrings(languageCode: strings.baseLanguageCode)
+    if let deleted = rawMessage.ayuDeletedAttribute {
+        dateText = "\(ecoStrings.get(deleted.isExpired ? .labelExpired : .labelDeleted)) \(dateText)"
+    } else if rawMessage.ayuIsMediaExpired {
+        dateText = "\(ecoStrings.get(.labelExpired)) \(dateText)"
+    } else if rawMessage.ayuIsViewOnce && rawMessage.ayuRevealsSelfDestructingMedia {
+        dateText = "\(ecoStrings.get(.labelOneView)) \(dateText)"
+    } else if let timeout = rawMessage.ayuSelfDestructTimeout {
+        dateText = "\(ecoStrings.selfDestructLabel(timeout: rawMessage.ayuSelfDestructRemaining ?? timeout)) \(dateText)"
+    }
     return dateText
 }
