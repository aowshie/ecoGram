+        self.interfaceInteraction?.cancelMessageSelection(.animated(duration: 0.4, curve: .spring))
+    }
+    
+    private func ecoArrangedButtons(tagButton: GlassButtonView?) -> [GlassButtonView] {
+        var available: [EcoSelectionAction: GlassButtonView] = [
+            .shot: self.shotButton,
+            .forward: self.forwardButton,
+            .share: self.shareButton,
+            .saveToCloud: self.cloudButton,
+            .hideSenderNames: self.forwardHideNamesButton
+        ]
+        if !self.deleteButton.isHidden {
+            available[.delete] = self.deleteButton
+        }
+        if !self.reportButton.isHidden {
+            available[.report] = self.reportButton
+        }
+        if let tagButton {
+            available[.tag] = tagButton
+        }
+        let result = EcoPreferences.shared.enabledSelectionActions.compactMap { available[$0] }
+        for button in [self.deleteButton, self.reportButton, self.forwardButton, self.cloudButton, self.forwardHideNamesButton, self.shareButton, self.tagButton, self.tagEditButton, self.shotButton] {
+            button.isHidden = !result.contains(where: { $0 === button })
+        }
+        return result
+    }
