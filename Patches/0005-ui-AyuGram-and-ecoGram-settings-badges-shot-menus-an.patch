+    func ecoForwardAsShot(messageIds: [EngineMessage.Id]) {
+        guard let navigationController = self.effectiveNavigationController, !messageIds.isEmpty else {
+            return
+        }
+        let image = Promise<UIImage?>()
+        image.set(ayuShotImage(context: self.context, messageIds: messageIds, parentView: navigationController.view))
+        let controller = self.context.sharedContext.makePeerSelectionController(PeerSelectionControllerParams(context: self.context, updatedPresentationData: self.updatedPresentationData, filter: [.onlyWriteable, .excludeDisabled, .doNotSearchMessages], hasFilters: true, selectForumThreads: true))
+        controller.peerSelected = { [weak self, weak controller] peer, threadId in
+            guard let self, let controller, !controller.inProgress else {
+                return
+            }
+            controller.inProgress = true
+            self.updateChatPresentationInterfaceState(animated: false, interactive: true, { $0.updatedInterfaceState({ $0.withoutSelectionState() }) })
+            let _ = (image.get()
+            |> take(1)
+            |> deliverOnMainQueue).startStandalone(next: { [weak self, weak controller] image in
+                guard let self, let controller else {
+                    return
+                }
+                guard let image else {
+                    controller.inProgress = false
+                    let presentationData = self.context.sharedContext.currentPresentationData.with { $0 }
+                    let text = EcoStrings(languageCode: presentationData.strings.baseLanguageCode).get(.shotFailed)
+                    controller.present(UndoOverlayController(presentationData: presentationData, content: .info(title: nil, text: text, timeout: nil, customUndoText: nil), elevatedLayout: false, action: { _ in
+                        return false
+                    }), in: .current)
+                    return
+                }
+                self.ecoOpenShotPaste(image: image, peerId: peer.id, threadId: threadId, selectionController: controller)
+            })
+        }
+        self.chatDisplayNode.dismissInput()
+        navigationController.pushViewController(controller)
+    }
+
+    private var ecoAcceptsShotPaste: Bool {
+        guard self.parentController == nil else {
+            return false
+        }
+        switch self.subject {
+        case nil, .some(.message):
+            return true
+        default:
+            return false
+        }
+    }
+
+    private func ecoOpenShotPaste(image: UIImage, peerId: EnginePeer.Id, threadId: Int64?, selectionController: ViewController) {
+        guard let navigationController = self.effectiveNavigationController else {
+            return
+        }
+        let paste: (ChatControllerImpl?) -> Void = { chatController in
+            chatController?.displayPasteMenu([.image(image)])
+        }
+        if case .peer(peerId) = self.chatLocation, threadId == nil, self.ecoAcceptsShotPaste {
+            let viewControllers = navigationController.viewControllers.filter { !($0 is PeerSelectionController) }
+            navigationController.setViewControllers(viewControllers, animated: true, completion: { [weak self] in
+                paste(self)
+            })
+            return
+        }
+        let proceed: (ChatController) -> Void = { [weak navigationController, weak selectionController] chatController in
+            guard let navigationController, let selectionController else {
+                return
+            }
+            var viewControllers = navigationController.viewControllers
+            guard let index = viewControllers.firstIndex(where: { $0 === selectionController }) else {
+                return
+            }
+            viewControllers.insert(chatController, at: index)
+            navigationController.setViewControllers(viewControllers, animated: false)
+            let _ = (chatController.ready.get()
+            |> SwiftSignalKit.filter { $0 }
+            |> take(1)
+            |> deliverOnMainQueue).startStandalone(next: { [weak navigationController, weak chatController] _ in
+                guard let navigationController else {
+                    return
+                }
+                let viewControllers = navigationController.viewControllers.filter { !($0 is PeerSelectionController) }
+                navigationController.setViewControllers(viewControllers, animated: true, completion: {
+                    paste(chatController as? ChatControllerImpl)
+                })
+            })
+        }
+        if let threadId {
+            let _ = (self.context.sharedContext.chatControllerForForumThread(context: self.context, peerId: peerId, threadId: threadId)
+            |> deliverOnMainQueue).startStandalone(next: { chatController in
+                proceed(chatController)
+            })
+        } else {
+            proceed(ChatControllerImpl(context: self.context, chatLocation: .peer(id: peerId)))
+        }
+    }
+}
